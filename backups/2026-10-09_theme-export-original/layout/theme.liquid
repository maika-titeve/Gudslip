    <script>
(function(){
  // 1) Convierte "24990" en "$24.990"
  function formatCLP(el) {
    const raw = el.textContent.replace(/[^\d]/g, '');
    const num = parseInt(raw, 10);
    if (!isNaN(num)) {
      el.textContent = new Intl.NumberFormat('es-CL', {
        style: 'currency',
        currency: 'CLP',
        minimumFractionDigits: 0
      }).format(num);
    }
  }

  // 2) Aplica el formateo a los precios de WideBundle
  function applyWideBundleFormatting() {
    document.querySelectorAll(
      '.first-price-WB, .second-price-WB, .crossed-price-WB'
    ).forEach(formatCLP);
  }

  // 3) Al cargar y luego cada 500 ms, reaplica el formateo
  document.addEventListener('DOMContentLoaded', () => {
    applyWideBundleFormatting();
    setInterval(applyWideBundleFormatting, 500);
  });
})();
</script>

