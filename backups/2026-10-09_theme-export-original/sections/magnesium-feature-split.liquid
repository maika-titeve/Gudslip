{{ 'magnesium-clone.css' | asset_url | stylesheet_tag }}
<section
  class="mag-clone mag-feature-split {% if section.settings.image_position == 'left' %}is-image-left{% else %}is-image-right{% endif %}"
  data-color-scheme="{{ section.settings.color_scheme | default: 'quaternary' }}"
>
  <div class="mag-wrap">
    <div class="mag-feature-inner">
      <div class="mag-feature-media">
        {% if section.settings.media_type == 'video' and section.settings.video != blank %}
          {{
            section.settings.video
            | video_tag:
              image_size: '1400x',
              autoplay: section.settings.video_autoplay,
              loop: section.settings.video_loop,
              muted: section.settings.video_muted,
              controls: section.settings.video_controls,
              class: 'mag-feature-video'
          }}
        {% elsif section.settings.image != blank %}
          {{ section.settings.image | image_url: width: 1800 | image_tag: loading: 'lazy' }}
        {% else %}
          {{ 'image' | placeholder_svg_tag: 'w-full h-auto mag-feature-ph' }}
        {% endif %}
      </div>
      <div class="mag-feature-content">
        {% if section.settings.kicker != blank %}<p class="mag-feature-kicker">{{ section.settings.kicker }}</p>{% endif %}
        {% if section.settings.title != blank %}<h2 class="mag-feature-title">{{ section.settings.title }}</h2>{% endif %}
        {% if section.settings.text != blank %}<div class="mag-feature-text rte">{{ section.settings.text }}</div>{% endif %}

        <ul class="mag-feature-list" role="list">
          {% for block in section.blocks %}
            <li class="mag-feature-item" {{ block.shopify_attributes }}>
              <span class="mag-feature-check" aria-hidden="true">✓</span>
              <span>{{ block.settings.text }}</span>
            </li>
          {% endfor %}
        </ul>

        {% if section.settings.button_link != blank and section.settings.button_label != blank %}
          <div class="mag-feature-cta-wrap">
            <a href="{{ section.settings.button_link }}" class="mag-cta">{{ section.settings.button_label }}</a>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Magnesium Feature Split",
  "settings": [
    {"type":"select","id":"image_position","label":"Image position","options":[{"value":"left","label":"Left"},{"value":"right","label":"Right"}],"default":"left"},
    {"type":"select","id":"media_type","label":"Media type","options":[{"value":"image","label":"Image"},{"value":"video","label":"Video"}],"default":"image"},
    {"type":"image_picker","id":"image","label":"Image"},
    {"type":"video","id":"video","label":"Video"},
    {"type":"checkbox","id":"video_autoplay","label":"Autoplay video","default":true},
    {"type":"checkbox","id":"video_muted","label":"Mute video","default":true},
    {"type":"checkbox","id":"video_loop","label":"Loop video","default":true},
    {"type":"checkbox","id":"video_controls","label":"Show video controls","default":false},
    {"type":"text","id":"kicker","label":"Kicker","default":"MAGNESIUM RITUAL"},
    {"type":"text","id":"title","label":"Title","default":"Beneficio principal"},
    {"type":"richtext","id":"text","label":"Text","default":"<p>Describe este bloque con detalle para que sea claro y convincente.</p>"},
    {"type":"url","id":"button_link","label":"Button link"},
    {"type":"text","id":"button_label","label":"Button label","default":"Compra ahora"},
    {"type":"select","id":"color_scheme","label":"Color scheme","options":[{"value":"primary","label":"Primary"},{"value":"secondary","label":"Secondary"},{"value":"tertiary","label":"Tertiary"},{"value":"quaternary","label":"Quaternary"}],"default":"quaternary"}
  ],
  "blocks": [
    {"type":"bullet","name":"Bullet","settings":[{"type":"text","id":"text","label":"Text","default":"Punto clave del beneficio"}]}
  ],
  "presets": [{"name":"Magnesium Feature Split","blocks":[{"type":"bullet"},{"type":"bullet"},{"type":"bullet"}]}]
}
{% endschema %}
