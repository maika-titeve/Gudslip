    "16508916323f758a49": {
      "type": "testimonials",
      "blocks": {
        "16508916326463ca2f-0": {
          "type": "testimonial",
          "settings": {
            "rating": "5_stars",
            "quote": "<p>This mouth tape has been a life-saver for my snoring issues! I wake up feeling more rested and my partner is thrilled!<\/p>",
            "source": "Carla Mendez"
          }
        },
        "16508916326463ca2f-1": {
          "type": "testimonial",
          "settings": {
            "rating": "5_stars",
            "quote": "<p>I was skeptical at first, but Gudslip® Mouth Tape really works. It's comfortable all night and easy to remove in the morning<\/p>",
            "source": "Felix Turner"
          }
        },
        "16508916326463ca2f-2": {
          "type": "testimonial",
          "settings": {
            "rating": "5_stars",
            "quote": "<p>No more dry mouth in the mornings! This tape helps me keep my mouth closed at night, and I really notice the difference.<\/p>",
            "source": "Isabella Garcia"
          }
        },
        "testimonial_WWmdDT": {
          "type": "testimonial",
          "settings": {
            "rating": "5_stars",
            "quote": "<p>The best part about Gudslip® tape is how gentle it is on my skin. No irritation at all, and it stays on all night.<\/p>",
            "source": "Kaitlyn Smith"
          }
        },
        "testimonial_Jwia4i": {
          "type": "testimonial",
          "settings": {
            "rating": "5_stars",
            "quote": "<p>Finally, a strip that sticks even if you toss and turn. Gudslip® Nose Strips stay put and make breathing so much easier.<\/p>",
            "source": "Monica Patel"
          }
        },
        "testimonial_bfyKXC": {
          "type": "testimonial",
          "settings": {
            "rating": "5_stars",
            "quote": "<p>I use these for my nighttime jogs as well. They help with my breathing and I feel less winded. Great for sports too!<\/p>",
            "source": "Nathan Wright"
          }
        },
        "testimonial_hnRbkF": {
          "type": "testimonial",
          "settings": {
            "rating": "5_stars",
            "quote": "<p>Gudslip® Nose Strips have reduced my nighttime congestion significantly. They're a must-have for allergy seasons.<\/p>",
            "source": "Olivia Martinez"
          }
        },
        "testimonial_PJqBeg": {
          "type": "testimonial",
          "settings": {
            "rating": "5_stars",
            "quote": "<p>These strips are very gentle yet effective. They don’t cause any irritation, and I've been sleeping better since I started using them.<\/p>",
            "source": "Steven Hall"
          }
        }
      },
