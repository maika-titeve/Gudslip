document.addEventListener('DOMContentLoaded', function () {
  const form = document.querySelector('#cart');
  const checkboxBoleta = document.querySelector('.add-boleta');
  const checkboxFactura = document.querySelector('.add-factura');
  const facturaContainer = document.querySelector('.factura-container');

  const hiddenFields = {
    "Boleta/Factura": form.querySelector('input[name="attributes[Boleta/Factura]"]'),
    "Rut": form.querySelector('input[name="attributes[Rut]"]'),
    "Giro": form.querySelector('input[name="attributes[Giro]"]'),
    "Razón social": form.querySelector('input[name="attributes[Razón social]"]'),
    "Dirección": form.querySelector('input[name="attributes[Dirección]"]'),
    "Región": form.querySelector('input[name="attributes[Región]"]'),
    "Comuna": form.querySelector('input[name="attributes[Comuna]"]'),
    "Correo": form.querySelector('input[name="attributes[Correo]"]')
  };

  const visibleFields = {
    "Rut": document.getElementById("rutInput"),
    "Giro": document.getElementById("giroInput"),
    "Razón social": document.getElementById("razonSocialInput"),
    "Dirección": document.getElementById("addressInput"),
    "Región": document.getElementById("regionInput"),
    "Comuna": document.getElementById("comunaInput"),
    "Correo": document.getElementById("emailInput")
  };


  checkboxFactura.checked = true;
  checkboxBoleta.checked = false;
  facturaContainer.style.display = 'block';
  hiddenFields["Boleta/Factura"].value = 'Factura';


  checkboxFactura.addEventListener('change', () => {
    const checked = checkboxFactura.checked;
    checkboxBoleta.checked = false;
    facturaContainer.style.display = checked ? 'block' : 'none';
    hiddenFields["Boleta/Factura"].value = checked ? 'Factura' : '';
    if (checked) visibleFields["Rut"].focus();
  });

  checkboxBoleta.addEventListener('change', () => {


 
    const checked = checkboxBoleta.checked;
    checkboxFactura.checked = false;
    facturaContainer.style.display = 'none';

    console.log(hiddenFields["Boleta/Factura"]);
    hiddenFields["Boleta/Factura"].value = checked ? 'Boleta' : '';

    Object.entries(visibleFields).forEach(([key, field]) => {
      field.value = '';
      hiddenFields[key].value = '';
      field.parentElement.classList.remove('invalid');
    });
  });

  Object.entries(visibleFields).forEach(([key, field]) => {
    field.addEventListener('input', () => {
      if (checkboxFactura.checked) {
        hiddenFields[key].value = field.value;
      }

      if (field.value.trim() !== '') {
        field.parentElement.classList.remove('invalid');
      }

      if (key === "Rut") {
        if (checkRut(field.value)) {
          field.parentElement.classList.remove('invalid');
        } else {
          field.parentElement.classList.add('invalid');
        }
      }
    });
  });

  const rutInput = visibleFields["Rut"];
  rutInput.addEventListener('input', () => {
    let value = rutInput.value.replace(/[^0-9kK]/g, '').toUpperCase();
    if (value.length > 1) {
      value = value.slice(0, -1) + '-' + value.slice(-1);
    }
    rutInput.value = value;

    if (checkRut(value)) {
      rutInput.parentElement.classList.remove('invalid');
    } else {
      rutInput.parentElement.classList.add('invalid');
    }

    hiddenFields["Rut"].value = value;
  });


  const regionInput = visibleFields["Región"];
  const comunaInput = visibleFields["Comuna"];

  regionInput.addEventListener('change', e => {
    const selectedCode = e.target.value;
    if (!selectedCode) {
      regionInput.parentElement.classList.add('invalid');
      comunaInput.innerHTML = '<option value="">Selecciona una comuna</option>';
      return;
    }

    regionInput.parentElement.classList.remove('invalid');

    const region = regionesComunas.find(r => r.regionCode === selectedCode);
    if (region && region.regionProvinces) {
      comunaInput.innerHTML = region.regionProvinces
        .map(p => `<option value="${p.displayName}">${p.displayName}</option>`)
        .join('');
    } else {
      comunaInput.innerHTML = '<option value="">Comunas no disponibles</option>';
    }

    hiddenFields["Región"].value = selectedCode;
    hiddenFields["Comuna"].value = '';
  });

  comunaInput.addEventListener('change', () => {
    hiddenFields["Comuna"].value = comunaInput.value;
    if (comunaInput.value) {
      comunaInput.parentElement.classList.remove('invalid');
    }
  });


form.addEventListener('submit', function (e) {

  if (checkboxFactura.checked) {
    let invalids = [];

    Object.entries(visibleFields).forEach(([key, field]) => {
      const value = field.value.trim();
      if (!value || (key === "Rut" && !checkRut(value))) {
        field.parentElement.classList.add('invalid');
        invalids.push(key);
      }
    });

    if (invalids.length > 0) {
      e.preventDefault();
      alert('Por favor, completa correctamente todos los campos requeridos para la factura.');
    }
  }
});

  // Validador RUT
  function checkRut(rut) {
    rut = rut.replace(/\./g, '').replace('-', '').toUpperCase();
    if (!/^[0-9]+[0-9K]$/.test(rut)) return false;

    const body = rut.slice(0, -1);
    const dv = rut.slice(-1);

    let sum = 0, multiplier = 2;
    for (let i = body.length - 1; i >= 0; i--) {
      sum += +body[i] * multiplier;
      multiplier = multiplier === 7 ? 2 : multiplier + 1;
    }

    let expectedDV = 11 - (sum % 11);
    expectedDV = expectedDV === 11 ? '0' : expectedDV === 10 ? 'K' : expectedDV.toString();

    return dv === expectedDV;
  }
});


</script>

