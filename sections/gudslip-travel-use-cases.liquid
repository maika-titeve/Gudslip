{%- liquid
  assign section_id = 'gudslip-travel-use-cases-' | append: section.id
-%}

<section id="{{ section_id }}" class="gudslip-travel-use-cases color-{{ section.settings.color_scheme }}">
  <div class="gudslip-travel-use-cases__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="gudslip-travel-use-cases__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="gudslip-travel-use-cases__grid" role="list">
      {%- for block in section.blocks -%}
        <article class="gudslip-travel-use-cases__card" role="listitem" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <div class="gudslip-travel-use-cases__image-wrap">
              {{ block.settings.image
                | image_url: width: 1000
                | image_tag:
                  loading: 'lazy',
                  widths: '360, 540, 720, 900, 1000',
                  sizes: '(min-width: 990px) 25vw, 88vw',
                  class: 'gudslip-travel-use-cases__image',
                  alt: block.settings.image.alt | default: block.settings.title
              }}
            </div>
          {%- endif -%}

          <h3 class="gudslip-travel-use-cases__title">{{ block.settings.title }}</h3>

          {%- if block.settings.text != blank -%}
            <div class="gudslip-travel-use-cases__text">{{ block.settings.text }}</div>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  #{{ section_id }} {
    --travel-use-cases-background: {{ section.settings.background_color }};
    --travel-use-cases-card: {{ section.settings.card_color }};
    --travel-use-cases-text: {{ section.settings.text_color }};
    background: var(--travel-use-cases-background);
    color: var(--travel-use-cases-text);
  }

  #{{ section_id }} .gudslip-travel-use-cases__inner {
    max-width: 1920px;
    margin: 0 auto;
    padding: 52px 5.2vw 58px;
  }

  #{{ section_id }} .gudslip-travel-use-cases__heading {
    margin: 0 0 42px;
    font-size: clamp(2rem, 3.1vw, 3.35rem);
    line-height: 1.08;
    letter-spacing: -0.045em;
    font-weight: 400;
  }

  #{{ section_id }} .gudslip-travel-use-cases__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 26px;
  }

  #{{ section_id }} .gudslip-travel-use-cases__card {
    min-width: 0;
    padding: 18px 18px 20px;
    border: 1px solid rgba(30, 30, 30, 0.1);
    border-radius: 24px;
    background: var(--travel-use-cases-card);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04);
  }

  #{{ section_id }} .gudslip-travel-use-cases__image-wrap {
    overflow: hidden;
    aspect-ratio: 1 / 1;
    border-radius: 17px;
  }

  #{{ section_id }} .gudslip-travel-use-cases__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #{{ section_id }} .gudslip-travel-use-cases__title {
    margin: 28px 0 20px;
    font-size: clamp(1.45rem, 2vw, 2rem);
    line-height: 1.1;
    letter-spacing: -0.035em;
    font-weight: 400;
  }

  #{{ section_id }} .gudslip-travel-use-cases__text {
    min-height: 170px;
    padding: 22px 20px;
    border-radius: 13px;
    background: rgba(245, 245, 245, 0.92);
    font-size: 1rem;
    line-height: 1.42;
  }

  @media screen and (max-width: 989px) {
    #{{ section_id }} .gudslip-travel-use-cases__inner {
      padding-right: 20px;
      padding-left: 20px;
    }

    #{{ section_id }} .gudslip-travel-use-cases__grid {
      display: flex;
      gap: 16px;
      overflow-x: auto;
      margin-right: -20px;
      padding-right: 20px;
      padding-bottom: 8px;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    #{{ section_id }} .gudslip-travel-use-cases__grid::-webkit-scrollbar { display: none; }

    #{{ section_id }} .gudslip-travel-use-cases__card {
      flex: 0 0 min(82vw, 390px);
      scroll-snap-align: start;
    }
  }
</style>

{% schema %}
{
  "name": "Usos de la almohada",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Tu mejor sueño te acompaña allá donde vayas." },
    { "type": "color", "id": "background_color", "label": "Color de fondo", "default": "#ffffff" },
    { "type": "color", "id": "card_color", "label": "Color de las tarjetas", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Color del texto", "default": "#202020" },
    { "type": "select", "id": "color_scheme", "label": "Esquema de color", "options": [{ "value": "scheme-1", "label": "Esquema 1" }, { "value": "scheme-2", "label": "Esquema 2" }], "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "use_case",
      "name": "Tarjeta de uso",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagen" },
        { "type": "text", "id": "title", "label": "Título", "default": "En el avión" },
        { "type": "richtext", "id": "text", "label": "Descripción", "default": "<p>Descansa de verdad durante tu viaje con un soporte cómodo y ergonómico.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Usos de la almohada",
      "blocks": [
        { "type": "use_case", "settings": { "title": "En el avión" } },
        { "type": "use_case", "settings": { "title": "En la carretera" } },
        { "type": "use_case", "settings": { "title": "En casa" } },
        { "type": "use_case", "settings": { "title": "En el sofá" } }
      ]
    }
  ]
}
{% endschema %}
