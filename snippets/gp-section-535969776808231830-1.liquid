                {% assign optionType = optionValue %}
            {% endif %}


            {% if optionKey == 'optionValues' %}

              {% assign opValueItems = optionValue | split: '($4)'  %}
              {% for opValueItem in opValueItems %}
                {% assign opValueItemAttrs = opValueItem | split: '($6)'  %}
