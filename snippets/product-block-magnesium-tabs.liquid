{% liquid
  assign tab_1_content_check = block.settings.tab_1_content | strip_html | replace: '&nbsp;', '' | strip
  assign tab_2_content_check = block.settings.tab_2_content | strip_html | replace: '&nbsp;', '' | strip
  assign tab_3_content_check = block.settings.tab_3_content | strip_html | replace: '&nbsp;', '' | strip
  assign tab_4_content_check = block.settings.tab_4_content | strip_html | replace: '&nbsp;', '' | strip

  assign has_tabs = false
  if block.settings.tab_1_label != blank and tab_1_content_check != blank
    assign has_tabs = true
  elsif block.settings.tab_2_label != blank and tab_2_content_check != blank
    assign has_tabs = true
  elsif block.settings.tab_3_label != blank and tab_3_content_check != blank
    assign has_tabs = true
  elsif block.settings.tab_4_label != blank and tab_4_content_check != blank
    assign has_tabs = true
  endif
%}

{% if has_tabs %}
  <div class="{{ block_base_classes }} mag-product-tabs" {{ block.shopify_attributes }}>
    {% if block.settings.tab_1_label != blank and tab_1_content_check != blank %}
      <details class="mag-product-accordion-item">
        <summary class="mag-product-accordion-trigger">
          <span>{{ block.settings.tab_1_label }}</span>
          <span class="mag-product-accordion-icon" aria-hidden="true"></span>
        </summary>
        <div class="mag-product-accordion-panel rte">{{ block.settings.tab_1_content }}</div>
      </details>
    {% endif %}

    {% if block.settings.tab_2_label != blank and tab_2_content_check != blank %}
      <details class="mag-product-accordion-item">
        <summary class="mag-product-accordion-trigger">
          <span>{{ block.settings.tab_2_label }}</span>
          <span class="mag-product-accordion-icon" aria-hidden="true"></span>
        </summary>
        <div class="mag-product-accordion-panel rte">{{ block.settings.tab_2_content }}</div>
      </details>
    {% endif %}

    {% if block.settings.tab_3_label != blank and tab_3_content_check != blank %}
      <details class="mag-product-accordion-item">
        <summary class="mag-product-accordion-trigger">
          <span>{{ block.settings.tab_3_label }}</span>
          <span class="mag-product-accordion-icon" aria-hidden="true"></span>
        </summary>
        <div class="mag-product-accordion-panel rte">{{ block.settings.tab_3_content }}</div>
      </details>
    {% endif %}

    {% if block.settings.tab_4_label != blank and tab_4_content_check != blank %}
      <details class="mag-product-accordion-item">
        <summary class="mag-product-accordion-trigger">
          <span>{{ block.settings.tab_4_label }}</span>
          <span class="mag-product-accordion-icon" aria-hidden="true"></span>
        </summary>
        <div class="mag-product-accordion-panel rte">{{ block.settings.tab_4_content }}</div>
      </details>
    {% endif %}
  </div>
{% endif %}
